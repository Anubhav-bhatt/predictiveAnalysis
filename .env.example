# ---------------------------------------------------------------------------
# EV Charger Predictive Intelligence Platform - Phase 1A
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

# Application
CPI_ENVIRONMENT=development
CPI_LOG_LEVEL=INFO
CPI_LOG_FORMAT=console            # console | json

# Database (async driver is added automatically)
CPI_DATABASE_HOST=localhost
CPI_DATABASE_PORT=5432
CPI_DATABASE_USER=cpi
CPI_DATABASE_PASSWORD=cpi
CPI_DATABASE_NAME=cpi
CPI_DATABASE_ECHO=false
CPI_DATABASE_POOL_SIZE=5
CPI_DATABASE_MAX_OVERFLOW=10

# Optional: full override. When set, the discrete fields above are ignored.
# CPI_DATABASE_URL=postgresql+asyncpg://cpi:cpi@localhost:5432/cpi

# API
CPI_API_HOST=0.0.0.0
CPI_API_PORT=8000
CPI_API_CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------------------
# Storage (Bronze raw landing zone)
# ---------------------------------------------------------------------------
CPI_STORAGE_RAW_ROOT=./data/raw
CPI_STORAGE_QUARANTINE_ROOT=./data/quarantine
CPI_STORAGE_PROCESSED_ROOT=./data/processed

# ---------------------------------------------------------------------------
# Filesystem telemetry source
# ---------------------------------------------------------------------------
CPI_SOURCE_FILESYSTEM_INBOX=./data/inbox
CPI_SOURCE_FILESYSTEM_GLOB=*.csv
# none | move  -- what acknowledge() does with the origin file
CPI_SOURCE_FILESYSTEM_ACK_STRATEGY=none
CPI_SOURCE_FILESYSTEM_ARCHIVE_DIR=./data/inbox_archive

# ---------------------------------------------------------------------------
# Safety limits (section 20). Nothing about an incoming file is trusted.
# ---------------------------------------------------------------------------
CPI_INGEST_MAX_FILE_SIZE_BYTES=536870912       # 512 MiB
CPI_INGEST_MAX_COLUMN_COUNT=2000
CPI_INGEST_MAX_ROW_COUNT=5000000
CPI_INGEST_ALLOWED_EXTENSIONS=[".csv"]

# ---------------------------------------------------------------------------
# Event time parsing (section 11). Day-first is explicit, never inferred.
# ---------------------------------------------------------------------------
CPI_INGEST_TIMESTAMP_FORMATS=["%d-%m-%Y %H:%M:%S","%d/%m/%Y %H:%M:%S","%Y-%m-%d %H:%M:%S","%Y-%m-%dT%H:%M:%S"]
CPI_INGEST_TIMESTAMP_FAILURE_TOLERANCE=0.02

# ---------------------------------------------------------------------------
# Expected topology (cardinality checks only - never used to drop data)
# ---------------------------------------------------------------------------
CPI_INGEST_EXPECTED_CONNECTOR_COUNT=2
CPI_INGEST_EXPECTED_SMR_COUNT=4
CPI_INGEST_TELEMETRY_GAP_FACTOR=5.0

# Values that look like data but are almost certainly "no reading".
# Phase 1A only profiles and flags these - it never rewrites them.
CPI_INGEST_GLOBAL_SENTINEL_VALUES=["-150","-999","-9999","65535"]

# ---------------------------------------------------------------------------
# Bulk manual upload (Phase 1C.5)
#
# Upload is an acquisition mechanism only: uploaded files run through exactly the
# same pipeline as filesystem-collected files. These limits protect the API process;
# they are NOT inferred from the ~16.5 MB reference sample, because a fleet backfill
# may present far larger or far more numerous files.
# ---------------------------------------------------------------------------
CPI_UPLOAD_MAX_FILES_PER_BATCH=200
CPI_UPLOAD_MAX_FILE_SIZE_BYTES=268435456
CPI_UPLOAD_MAX_BATCH_SIZE_BYTES=5368709120
CPI_UPLOAD_ALLOWED_EXTENSIONS=[".csv"]

# Where uploaded bytes wait before registration. Deliberately distinct from Bronze:
# a staged file has not yet been accepted as a telemetry file, and if it turns out
# to be a duplicate it never becomes one.
CPI_UPLOAD_STAGING_ROOT=./data/uploads

# ---------------------------------------------------------------------------
# Optional: path to the real production-like charger CSV for the
# opt-in integration profile run. Leave unset if unavailable.
# ---------------------------------------------------------------------------
# CPI_REAL_SAMPLE_PATH=/absolute/path/to/charger_daily.csv
